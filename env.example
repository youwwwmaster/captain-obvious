BOT_TOKEN=your_bot_token_here
# Username бота без @ — ссылка на условия (t.me/…?start=terms) в группах и если нет ctx.me
BOT_USERNAME=your_bot_username
WEBHOOK_DOMAIN=https://your-domain.com
WEBHOOK_PORT=3000

AI_PROVIDER=openai
MODEL=gpt-5.4-mini
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# PostgreSQL: в docker-compose пароль контейнера postgres = DB_PASSWORD (см. POSTGRES_PASSWORD)
DB_PASSWORD=your_db_password_here
# Docker: хост postgres, пользователь captain, БД captain_obvious — пароль в URL = DB_PASSWORD
DATABASE_URL=postgresql://captain:your_db_password_here@postgres:5432/captain_obvious

DAILY_LIMIT=10

# Пакет Telegram Stars: цена (XTR) и число бонусных вызовов
STARS_PACK_PRICE=3
STARS_PACK_CALLS=10

# Куда пересылать /support: только числовой user id (например @userinfobot). @username не использовать — в личку Bot API так не шлёт.
SUPPORT_ADMIN_CHAT_ID=
