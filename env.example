BOT_TOKEN=your_bot_token_here
# Bot username without @ — terms link (t.me/…?start=terms) in groups when ctx.me is missing
BOT_USERNAME=your_bot_username
WEBHOOK_DOMAIN=https://your-domain.com
WEBHOOK_PORT=3000

AI_PROVIDER=openai
MODEL=gpt-5.4-mini
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# PostgreSQL: docker-compose sets POSTGRES_PASSWORD from DB_PASSWORD
DB_PASSWORD=your_db_password_here
# Docker: host postgres, user captain, DB captain_obvious — password in URL must match DB_PASSWORD
DATABASE_URL=postgresql://captain:your_db_password_here@postgres:5432/captain_obvious

DAILY_LIMIT=10

# Telegram Stars pack: price (XTR) and number of bonus calls
STARS_PACK_PRICE=3
STARS_PACK_CALLS=10

# /support forwards here: numeric Telegram user id only (e.g. from @userinfobot). @username does not work for Bot API DMs.
SUPPORT_ADMIN_CHAT_ID=
